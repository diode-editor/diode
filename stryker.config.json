{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "packageManager": "npm",
  "testRunner": "vitest",
  "vitest": {
    "configFile": "vitest.config.ts"
  },
  "coverageAnalysis": "perTest",
  "concurrency": "50%",
  "reporters": ["html", "clear-text", "progress"],
  "thresholds": {
    "high": 100,
    "low": 100,
    "break": 100
  },
  "ignorePatterns": [
    ".claude/worktrees",
    "dist",
    "coverage",
    "reports",
    ".stryker-tmp",
    "screenshots",
    "extensions/*/out",
    ".agents-runs",
    ".git"
  ]
}
