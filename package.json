{
  "name": "diode",
  "version": "0.3.0",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "start": "tsx src/vs/diode/main.ts",
    "prestart": "npm run build:extensions",
    "build:extensions": "node scripts/build-extensions.mjs",
    "demo:terminal": "tsx src/demos/terminal/terminalHost.ts",
    "screenshots": "tsx e2e/scenarios/generate.ts",
    "build": "tsup",
    "build:sea": "node scripts/build-sea.mjs",
    "build:selfextract": "node scripts/build-selfextract.mjs",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "test:perf": "vitest bench --run --config vitest.perf.config.ts",
    "test:mutation": "node scripts/mutation-diff.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/ extensions/",
    "lint:fix": "eslint src/ extensions/ --fix",
    "valid-layers-check": "node scripts/check-layers.mjs",
    "import:vscode-diff": "node scripts/import-vscode-diff.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@resvg/resvg-js": "^2.6.2",
    "@stryker-mutator/core": "^10.0.0",
    "@stryker-mutator/vitest-runner": "^10.0.0",
    "@types/node": "^25.5.2",
    "@types/ws": "^8.18.1",
    "@types/yauzl": "^3.4.0",
    "@types/yazl": "^3.3.1",
    "@vitest/coverage-v8": "^4.0.18",
    "esbuild": "^0.27.3",
    "eslint": "^10.0.3",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "jiti": "^2.6.1",
    "prettier": "^3.8.1",
    "tsup": "^8.5.1",
    "tsx": "^4.21.0",
    "typescript": "^5.8",
    "typescript-eslint": "^8.56.1",
    "typescript-language-server": "^5.3.0",
    "vitest": "^4.0.18",
    "vscode-languageclient": "^10.1.0",
    "ws": "^8.21.0",
    "yazl": "^3.3.1"
  },
  "dependencies": {
    "@tuidom/core": "^0.2.0",
    "@tuidom/elements": "^0.2.0",
    "@tuidom/headless-backend": "^0.2.0",
    "@tuidom/inspector": "^0.2.0",
    "@tuidom/terminal-backend": "^0.2.0",
    "@tuidom/testing": "^0.2.0",
    "@vscode/ripgrep": "^1.18.0",
    "@xterm/headless": "^6.0.0",
    "chokidar": "^5.0.0",
    "iconv-lite": "^0.7.3",
    "jsonc-parser": "^3.3.1",
    "node-pty": "^1.1.0",
    "vscode-oniguruma": "^2.0.1",
    "vscode-textmate": "^9.3.2",
    "vscode-uri": "^3.1.0",
    "yauzl": "^3.4.0"
  }
}
