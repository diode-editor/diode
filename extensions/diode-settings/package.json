{
  "name": "settings",
  "displayName": "Settings Editing",
  "description": "IntelliSense for settings.json and launch.json: completes known configuration keys and the debuggers' launch configuration attributes.",
  "version": "0.1.0",
  "publisher": "diode",
  "license": "MIT",
  "type": "module",
  "engines": {
    "vscode": "^1.127.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onLanguage:json",
    "onLanguage:jsonc"
  ],
  "contributes": {
    "languages": [
      {
        "id": "jsonc",
        "extensions": [
          ".code-workspace"
        ]
      }
    ],
    "configurationDefaults": {
      "[json]": {
        "editor.quickSuggestions": {
          "strings": true
        }
      },
      "[jsonc]": {
        "editor.quickSuggestions": {
          "strings": true
        }
      }
    }
  },
  "main": "./out/extension.cjs"
}
