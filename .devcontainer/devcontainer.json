{
	"name": "Diode Development",
	// Tag without a hyphen: that is how mcr spells 26.04, unlike ubuntu-24.04.
	// The digest is of the index, not of a specific architecture: the pin stays
	// multi-arch, and one config works on an aarch64 laptop, an x86 remote box and in Codespaces.
	"image": "mcr.microsoft.com/devcontainers/base:ubuntu26.04@sha256:1f8bb87ca6d342a587a9163a5a1ea8c487bcd4f149e8483a5ff711f795f0776d",
	"features": {
		"ghcr.io/devcontainers/features/github-cli:1": {},
		"ghcr.io/devcontainers/features/node:1": {
			"version": "26.12.0"
		},
		"ghcr.io/anthropics/devcontainer-features/claude-code:1": {}
	},
	"customizations": {
		"vscode": {
			"extensions": [
				"dbaeumer.vscode-eslint",
				"esbenp.prettier-vscode",
				"vitest.explorer"
			]
		}
	},
	"containerEnv": {
		"LANG": "en_US.UTF-8"
	},
	"remoteUser": "vscode",
	// onCreate, not postCreate: Codespaces prebuild runs exactly
	// onCreateCommand, so the heavy part lands in the prebuilt image.
	"onCreateCommand": "bash .devcontainer/setup.sh"
}
