{
    "name": "sample-lang",
    "displayName": "Diode Sample Language",
    "description": "Synthetic extension for marketplace checks: its own .diodesample language with a grammar, no extension code.",
    "version": "0.0.1",
    "publisher": "test",
    "engines": {
        "vscode": "^1.0.0"
    },
    "contributes": {
        "languages": [
            {
                "id": "diodesample",
                "aliases": ["Diode Sample", "diodesample"],
                "extensions": [".diodesample"]
            }
        ],
        "grammars": [
            {
                "language": "diodesample",
                "scopeName": "source.diodesample",
                "path": "./syntaxes/diodesample.tmGrammar.json"
            }
        ]
    }
}
