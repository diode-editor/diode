{
    // A theme on top of a base: `include` resolves relative to this file, the colors
    // below override the base's keys of the same name, the rest (tokenColors too) comes from it.
    "include": "./sample-dark.json",
    "colors": {
        "editor.background": "#0B1015",
        "statusBar.background": "#05080B"
    }
}
