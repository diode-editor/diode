{
    "name": "ext-storage-demo",
    "displayName": "Ext Storage Demo",
    "description": "Demo of extension storage directories (globalStorageUri/storageUri/logUri) and the setContext command: the key gates the extension's own keybinding.",
    "version": "0.0.1",
    "publisher": "test",
    "main": "./extension.js",
    "engines": {
        "vscode": "^1.0.0"
    },
    "activationEvents": ["*"],
    "contributes": {
        "commands": [
            { "command": "extStorageDemo.arm", "title": "Ext Storage Demo: Arm" },
            { "command": "extStorageDemo.disarm", "title": "Ext Storage Demo: Disarm" },
            { "command": "extStorageDemo.showPaths", "title": "Ext Storage Demo: Show Paths" }
        ],
        "keybindings": [
            {
                "command": "extStorageDemo.fire",
                "key": "alt+q",
                "when": "extStorageDemo.armed"
            }
        ]
    }
}
