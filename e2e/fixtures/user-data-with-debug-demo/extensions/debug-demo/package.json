{
    "name": "debug-demo",
    "displayName": "Debug Demo",
    "description": "A debugger extension shaped like CodeLLDB: the `demo` debug type, its configuration provider and `${command:pickProgram}`. It has no adapter: a start ends with the core's message about it.",
    "version": "0.0.1",
    "publisher": "test",
    "main": "./extension.js",
    "engines": {
        "vscode": "^1.0.0"
    },
    "activationEvents": [
        "onDebugResolve:demo"
    ],
    "contributes": {
        "debuggers": [
            {
                "type": "demo",
                "label": "Debug Demo",
                "languages": ["cpp"],
                "variables": {
                    "pickProgram": "debugDemo.pickProgram"
                },
                "initialConfigurations": [
                    {
                        "type": "demo",
                        "request": "launch",
                        "name": "Debug Demo",
                        "program": "${command:pickProgram}"
                    }
                ]
            }
        ]
    }
}
