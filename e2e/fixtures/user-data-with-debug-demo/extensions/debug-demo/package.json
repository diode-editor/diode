{
    "name": "debug-demo",
    "displayName": "Debug Demo",
    "description": "A debugger extension shaped like CodeLLDB: the `demo` debug type, its configuration provider, `${command:pickProgram}`, an inline adapter that stops on entry and a tracker.",
    "version": "0.0.1",
    "publisher": "test",
    "main": "./extension.js",
    "engines": {
        "vscode": "^1.0.0"
    },
    "activationEvents": [
        "onDebugResolve:demo",
        "onDebugDynamicConfigurations:demo",
        "onCommand:debugDemo.breakOnPrintf"
    ],
    "contributes": {
        "breakpoints": [{ "language": "c" }],
        "commands": [
            {
                "command": "debugDemo.breakOnPrintf",
                "title": "Break on printf",
                "category": "Debug Demo"
            }
        ],
        "debuggers": [
            {
                "type": "demo",
                "label": "Debug Demo",
                "languages": ["cpp"],
                "variables": {
                    "pickProgram": "debugDemo.pickProgram"
                },
                "configurationAttributes": {
                    "launch": {
                        "properties": {
                            "program": {
                                "type": "string",
                                "description": "Path to the program to debug."
                            },
                            "stopOnEntry": {
                                "type": "boolean",
                                "description": "Stop on the first line of the program.",
                                "default": true
                            }
                        }
                    }
                },
                "configurationSnippets": [
                    {
                        "label": "Debug Demo: Launch",
                        "description": "A new configuration for the demo debugger.",
                        "body": {
                            "type": "demo",
                            "request": "launch",
                            "name": "${1:Debug Demo}",
                            "program": "${2:./hello}"
                        }
                    }
                ],
                "initialConfigurations": [
                    {
                        "type": "demo",
                        "request": "launch",
                        "name": "Debug Demo",
                        "program": "${command:pickProgram}"
                    }
                ]
            }
        ]
    }
}
