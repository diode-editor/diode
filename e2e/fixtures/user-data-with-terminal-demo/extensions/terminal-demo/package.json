{
    "name": "terminal-demo",
    "displayName": "Terminal Demo",
    "description": "Terminals demo: createTerminal + sendText + show, like the bazel-java cleanup commands and Code Runner; a pty log terminal, like Bazel Build Status; window.terminals and events in the status bar.",
    "version": "0.0.1",
    "publisher": "test",
    "main": "./extension.js",
    "engines": {
        "vscode": "^1.0.0"
    },
    "activationEvents": [
        "*"
    ],
    "contributes": {
        "commands": [
            {
                "command": "terminalDemo.run",
                "title": "Terminal Demo: Run in Terminal"
            },
            {
                "command": "terminalDemo.beside",
                "title": "Terminal Demo: Open Agent Beside"
            },
            {
                "command": "terminalDemo.list",
                "title": "Terminal Demo: List Terminals"
            },
            {
                "command": "terminalDemo.dispose",
                "title": "Terminal Demo: Dispose"
            },
            {
                "command": "terminalDemo.log",
                "title": "Terminal Demo: Show Log"
            }
        ]
    }
}
