{
    "name": "content-provider-probe",
    "publisher": "diode-test",
    "version": "0.0.1",
    "engines": {
        "vscode": "^1.80.0"
    },
    "main": "./extension.js",
    "activationEvents": [
        "onStartupFinished"
    ],
    "contributes": {
        "commands": [
            {
                "command": "probe.openVirtual",
                "title": "Open Virtual Document",
                "category": "Probe"
            },
            {
                "command": "probe.setLanguage",
                "title": "Set Language To Python",
                "category": "Probe"
            },
            {
                "command": "probe.pickFolder",
                "title": "Pick Folder",
                "category": "Probe"
            }
        ]
    }
}