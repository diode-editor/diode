    "version": "0.0.1",
    "publisher": "test",
    "main": "./extension.js",
    "engines": {
        "vscode": "^1.0.0"
    },
    "activationEvents": ["onCommand:showBesideDemo.open"],
    "contributes": {
        "commands": [
            {
                "command": "showBesideDemo.open",
                "title": "Show Beside Demo: Open"
            }
        ]
    }
}
