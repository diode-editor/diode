{
    "name": "tree-outline",
    "displayName": "Tree Outline",
    "description": "E2E demo extension: a build-targets tree whose module extends vscode.TreeItem; a target's command shows a toast, Add Target fires onDidChangeTreeData.",
    "version": "0.0.1",
    "publisher": "test",
    "main": "./extension.js",
    "engines": {
        "vscode": "^1.0.0"
    },
    "contributes": {
        "commands": [
            {
                "command": "treeOutline.addTarget",
                "title": "Tree Outline: Add Target"
            },
            {
                "command": "treeOutline.run",
                "title": "Tree Outline: Run Target"
            }
        ],
        "views": {
            "explorer": [
                {
                    "id": "treeOutline.targets",
                    "name": "Run Targets"
                }
            ]
        }
    }
}
